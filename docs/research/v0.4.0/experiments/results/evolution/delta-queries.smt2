(set-logic QF_LIA)
(set-option :produce-models true)
(echo "rule")
(push 1)
(declare-const day1 Int)
(assert (and (>= day1 0) (<= day1 60) (> day1 30)))
(check-sat)
(get-value (day1))
(pop 1)
(echo "domain")
(push 1)
(declare-const capacity2 Int)
(declare-const used2 Int)
(assert (and (> capacity2 0) (<= 0 used2) (< used2 capacity2) (> (+ used2 2) capacity2)))
(check-sat)
(get-value (capacity2 used2))
(pop 1)
(echo "external")
(push 1)
(declare-const issuer3 Int)
(assert (and (or (= issuer3 0) (= issuer3 1)) (not (= issuer3 0))))
(check-sat)
(get-value (issuer3))
(pop 1)
(echo "unrelated")
(push 1)
(assert (not (= 60 60)))
(check-sat)
(pop 1)
(echo "editorial")
(push 1)
(assert (not (= 60 60)))
(check-sat)
(pop 1)
