(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const capacity Int)
(declare-const used Int)
(declare-const state Int)
(declare-const days Int)
(declare-const nextUsed Int)
(declare-const nextState Int)
(declare-const owner Int)
(declare-const nextOwner Int)
(define-fun Inv ((s Int) (u Int) (c Int)) Bool
 (and (> c 0) (<= 0 u) (<= u c) (<= 0 s) (<= s 3) (=> (= s 1) (> u 0))))
; 0 REQUESTED, 1 CONFIRMED, 2 CANCELLED, 3 EXPIRED
(define-fun Guard () Bool (and (= state 0) (>= days 0) (<= days 60) (< used capacity)))
(echo "domain-witness")
(push 1)
(assert (Inv state used capacity))
(assert Guard)
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "confirm-preserves-invariant")
(push 1)
(assert (Inv state used capacity))
(assert Guard)
(assert (= nextUsed (+ used 1)))
(assert (= nextState 1))
(assert (not (Inv nextState nextUsed capacity)))
(check-sat)
(pop 1)
(echo "cancel-preserves-invariant")
(push 1)
(assert (Inv state used capacity))
(assert (= state 1))
(assert (= nextUsed (- used 1)))
(assert (= nextState 2))
(assert (not (Inv nextState nextUsed capacity)))
(check-sat)
(pop 1)
(echo "expire-preserves-invariant")
(push 1)
(assert (Inv state used capacity))
(assert (= state 1))
(assert (= nextUsed (- used 1)))
(assert (= nextState 3))
(assert (not (Inv nextState nextUsed capacity)))
(check-sat)
(pop 1)
(echo "contradictory-rules")
(push 1)
(assert (>= days 0))
(assert (<= days 60))
(assert (>= days 61))
(check-sat)
(pop 1)
(echo "bad-guard-vacuous-safety")
(push 1)
(assert (Inv state used capacity))
(assert (< used 0))
(assert (not (Inv 1 (+ used 1) capacity)))
(check-sat)
(pop 1)
(echo "bad-guard-unreachable")
(push 1)
(assert (Inv state used capacity))
(assert (< used 0))
(check-sat)
(pop 1)
(echo "weak-contract-counterexample")
(push 1)
(assert (Inv state used capacity))
(assert Guard)
(assert (>= nextUsed used))
(assert (= nextState 1))
(assert (> nextUsed capacity))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "structured-behaviour-baseline")
(push 1)
(assert (= capacity 1))
(assert (= used 0))
(assert (= state 0))
(assert (= days 30))
(assert Guard)
(assert (= nextUsed (+ used 1)))
(assert (= nextUsed 1))
(assert (= nextState 1))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "structured-behaviour-survives-guard-mutant")
(push 1)
(assert (= capacity 1))
(assert (= used 0))
(assert (= state 0))
(assert (= days 30))
(assert (and (>= days 0) (<= days 60)))
(assert (= nextUsed (+ used 1)))
(assert (= nextUsed 1))
(assert (= nextState 1))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "guard-mutant-overbooks")
(push 1)
(assert (Inv state used capacity))
(assert (= state 0))
(assert (and (>= days 0) (<= days 60)))
(assert (= nextUsed (+ used 1)))
(assert (> nextUsed capacity))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "missing-frame-changes-owner")
(push 1)
(assert (Inv state used capacity))
(assert Guard)
(assert (= nextUsed (+ used 1)))
(assert (not (= nextOwner owner)))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "explicit-frame-preserves-owner")
(push 1)
(assert (= nextOwner owner))
(assert (not (= nextOwner owner)))
(check-sat)
(pop 1)
(echo "double-release-mutant")
(push 1)
(assert (Inv state used capacity))
(assert (= state 1))
; cancel then wrongly expire CANCELLED again
(assert (= nextUsed (- (- used 1) 1)))
(assert (< nextUsed 0))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "correct-expiry-refuses-cancelled")
(push 1)
(assert (= state 2))
(assert (= state 1))
(check-sat)
(pop 1)
(echo "lead-rule-change-breaks-old-contract")
(push 1)
(assert (Inv state used capacity))
(assert (= state 0))
(assert (< used capacity))
(assert (> days 30))
(assert (<= days 60))
(assert (= nextState 1))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
(echo "hours-conversion-counterexample")
(push 1)
(assert (> days 60))
(assert (<= days 1440))
(check-sat)
(get-value (capacity used state days nextUsed nextState owner nextOwner))
(pop 1)
