(set-logic QF_LIA)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :produce-proofs true)
(declare-const x Int)
(assert (! (>= x 0) :named lower))
(assert (! (<= x 2) :named upper))
(check-sat)
(get-value (x))
(assert (! (> x 2) :named contradiction))
(check-sat)
(get-unsat-core)
(get-proof)
